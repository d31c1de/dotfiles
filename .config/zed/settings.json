{
  "close_panel_on_toggle": false,
  "ui_font_size": 15.0,
  "disable_ai": true,
  "language_models": {
    "opencode": {
      "show_go_models": true,
      "show_zen_models": true
    }
  },
  "agent_servers": {
    
  },
  "use_system_window_tabs": false,
  "helix_mode": false,
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "toolbar": {
    "quick_actions": true,
    "breadcrumbs": true
  },
  "scrollbar": {
    "axes": {
      "vertical": true,
      "horizontal": true
    },
    "diagnostics": "all",
    "cursors": true,
    "search_results": true,
    "git_diff": true,
    "show": "auto"
  },
  "relative_line_numbers": "disabled",
  "minimap": {
    "thumb_border": "left_open",
    "thumb": "always",
    "show": "always"
  },
  "which_key": {
    "delay_ms": 100,
    "enabled": false
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "cli_default_open_behavior": "existing_window",
  "format_on_save": "on",
  "cursor_blink": false,
  "ui_font_family": "Bai Jamjuree",
  "buffer_font_family": "Maple Mono NF",
  "terminal": {
    "font_family": "Maple Mono NF",
    "font_size": 15.0,
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "light",
    "light": "Soft Charmed Icons",
    "dark": "Soft Charmed Icons"
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "opencode",
      "model": "go/deepseek-flash",
      "enable_thinking": false
    },
    "threads_sidebar_default_width": 0.0,
    "terminal_init_command": "",
    "sidebar_side": "right",
    "default_profile": "minimal",
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "experimental.theme_overrides": {
    "players": [
      {
        "cursor": "#CDD6F4",
      },
    ],
  },
  "languages": {
    "Python": {
      "language_servers": [
        // Enable ty, disable basedpyright, and enable all
        // other registered language servers (ruff, pylsp, pyright).
        "!pyright",
        "basedpyright",
        "...",
      ],
    },
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright.analysis": {
          "diagnosticMode": "workspace",
          "typeCheckingMode": "off",
        },
      },
    },
    "tinymist": {
      "initialization_options": {
        // Enable background preview
        // Server will be running on 127.0.0.1:23635
        "preview": {
          "background": {
            "enabled": true,
          },
        },
      },
      "settings": {
        // Compile on save
        // This will compile a PDF for the `main.typ` file in the project root.
        "exportPdf": "onSave",
        "outputPath": "$root/$name",

        // Enable formatter
        "formatterMode": "typstyle",
      },
    },
  },
}
